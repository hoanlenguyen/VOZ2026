# Liiga stats API key (sent as the x-api-key header)
NUXT_LIIGA_API_KEY=

# football-data.org token (sent as X-Auth-Token). Free plan: 12 top competitions, 10 requests/minute.
# Register at https://www.football-data.org/client/register
NUXT_FOOTBALL_DATA_TOKEN=

# GNews API key for "What the press says" headlines (free plan: 100 requests/day). https://gnews.io
NUXT_GNEWS_API_KEY=

# OpenAI key for AI match stories (model gpt-6-luna). Without it, stories fall back to the
# pre-written bundle (npm run warm:stories) or the template.
NUXT_OPENAI_API_KEY=

# live: upstream APIs only | auto: live, fall back to snapshot | snapshot: offline demo
NUXT_DATA_MODE=auto

# Hugging Face Inference Providers token + chat model for the headline translation agent
# (server/utils/translate.ts). Without a token, press headlines are shown untranslated.
NUXT_HF_TOKEN=
NUXT_HF_MODEL=openai/gpt-oss-120b
