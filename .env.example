# Liiga stats API key (sent as the x-api-key header)
NUXT_LIIGA_API_KEY=

# football-data.org token (sent as X-Auth-Token). Free plan: 12 top competitions, 10 requests/minute.
# Register at https://www.football-data.org/client/register
NUXT_FOOTBALL_DATA_TOKEN=

# GNews API key for "What the press says" headlines (free plan: 100 requests/day). https://gnews.io
NUXT_GNEWS_API_KEY=

# OpenAI key for AI match stories and press-headline translation (model gpt-6-luna). Without it,
# stories fall back to the pre-written bundle (npm run warm:stories) or the template, and
# headlines stay untranslated.
NUXT_OPENAI_API_KEY=
# Model for AI match stories and headline translation: API id or display name (gpt-6-luna = GPT-6 Luna).
# Switching models makes the new model write its own stories instead of reusing the pre-written ones.
NUXT_OPENAI_MODEL=gpt-6-luna
# AI podcasts: text-to-speech model and voice (OpenAI /v1/audio/speech; these models are deprecated
# on 2027-01-06). The podcast script is written by NUXT_OPENAI_MODEL.
NUXT_OPENAI_TTS_MODEL=gpt-4o-mini-tts
NUXT_PODCAST_VOICE=marin

# Signs the demo session cookie (any long random string; a demo secret is used when empty)
NUXT_SESSION_SECRET=

# live: upstream APIs only | auto: live, fall back to snapshot | snapshot: offline demo
NUXT_DATA_MODE=auto

# Team summaries require a headline click; match synthesis is available through the API.
# Team summaries are cached for up to 24 hours and invalidated sooner when source text changes.
# News summaries use NUXT_OPENAI_API_KEY / NUXT_OPENAI_MODEL above.
NUXT_NEWS_AI_PROVIDER=openai
# Optional alternative: set NUXT_NEWS_AI_PROVIDER=huggingface
NUXT_HF_TOKEN=
NUXT_HF_MODEL=openai/gpt-oss-120b
NUXT_NEWS_MONITOR_ENABLED=true
# Maximum background AI classifications per UTC day; 0 uses rule-based importance only.
NUXT_NEWS_ASSESSMENT_DAILY_LIMIT=100
