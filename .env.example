# Liiga stats API key (sent as the x-api-key header)
NUXT_LIIGA_API_KEY=

# football-data.org token (sent as X-Auth-Token). Free plan: 12 top competitions, 10 requests/minute.
# Register at https://www.football-data.org/client/register
NUXT_FOOTBALL_DATA_TOKEN=

# GNews API key for "What the press says" headlines (free plan: 100 requests/day). https://gnews.io
NUXT_GNEWS_API_KEY=

# live: upstream APIs only | auto: live, fall back to snapshot | snapshot: offline demo
NUXT_DATA_MODE=auto

# Match summaries load automatically before/after play; team summaries require a headline click.
# Team summaries are cached for up to 24 hours and invalidated sooner when source text changes.
NUXT_NEWS_AI_PROVIDER=openai
NUXT_OPENAI_API_KEY=
NUXT_OPENAI_MODEL=gpt-6-luna
# Optional alternative: set NUXT_NEWS_AI_PROVIDER=huggingface
NUXT_HF_TOKEN=
NUXT_HF_MODEL=openai/gpt-oss-120b
NUXT_NEWS_MONITOR_ENABLED=true
# Maximum background AI classifications per UTC day; 0 uses rule-based importance only.
NUXT_NEWS_ASSESSMENT_DAILY_LIMIT=100
