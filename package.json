{
  "name": "voz",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt build && wrangler dev",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
