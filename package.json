    "warm:stories": "node scripts/warm-stories.ts"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "nuxt": "^4.6.2",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
