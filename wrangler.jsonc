{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voz",
  // Built by `nuxt build` (Nitro preset cloudflare_module, see nuxt.config.ts)
  "main": "./.output/server/index.mjs",
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS"
  },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Daily AI podcasts at 05:00 UTC (08:00 in Helsinki in summer, 07:00 in winter); nuxt.config
  // nitro.scheduledTasks maps this cron to the podcasts:daily task.
  "triggers": { "crons": ["0 5 * * *"] },
  // Upstream response cache shared by all Worker instances (football-data and GNews have tight
  // per-token quotas; per-instance memory caches would each spend them). Nitro storage "kvcache".
  "kv_namespaces": [
    { "binding": "VOZ_CACHE", "id": "18009bda6a954a67b6adecd715d3dda5" }
  ],
  // Non-secret settings. API keys are Worker secrets (NUXT_LIIGA_API_KEY, NUXT_FOOTBALL_DATA_TOKEN, NUXT_GNEWS_API_KEY, NUXT_OPENAI_API_KEY),
  // set by the deploy workflow from GitHub secrets; locally they come from .dev.vars.
  "vars": {
    "NUXT_DATA_MODE": "auto",
    // AI match story model: display name or API id. Change it here and deploy to switch models.
    "NUXT_OPENAI_MODEL": "GPT-6 Luna"
  }
}
